{% extends 'base.html.twig' %}

{% block title %}Estudiante{% endblock %}

{% block body %}
    <h1>Estudiante</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ estudiante.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ estudiante.nombre }}</td>
            </tr>
            <tr>
                <th>Apellidos</th>
                <td>{{ estudiante.apellidos }}</td>
            </tr>
            <tr>
                <th>Dni</th>
                <td>{{ estudiante.dni }}</td>
            </tr>
            <tr>
                <th>Direccion</th>
                <td>{{ estudiante.direccion }}</td>
            </tr>
            <tr>
                <th>Poblacion</th>
                <td>{{ estudiante.poblacion }}</td>
            </tr>
            <tr>
                <th>Telefono</th>
                <td>{{ estudiante.telefono }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_estudiante_index') }}">Inicio</a>

    <a href="{{ path('app_estudiante_edit', {'id': estudiante.id}) }}">Editar</a>

    {{ include('estudiante/_delete_form.html.twig') }}
{% endblock %}
