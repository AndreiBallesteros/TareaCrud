{% extends 'base.html.twig' %}

{% block title %}Estudiante index{% endblock %}

{% block body %}
    <h1>Práctica de Despliegue</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Dni</th>
                <th>Direccion</th>
                <th>Poblacion</th>
                <th>Telefono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for estudiante in estudiantes %}
            <tr>
                <td>{{ estudiante.id }}</td>
                <td>{{ estudiante.nombre }}</td>
                <td>{{ estudiante.apellidos }}</td>
                <td>{{ estudiante.dni }}</td>
                <td>{{ estudiante.direccion }}</td>
                <td>{{ estudiante.poblacion }}</td>
                <td>{{ estudiante.telefono }}</td>
                <td>
                    <a href="{{ path('app_estudiante_show', {'id': estudiante.id}) }}">Detalles</a>
                    <a href="{{ path('app_estudiante_edit', {'id': estudiante.id}) }}">Editar</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">Aún no hay estudiantes matriculados</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_estudiante_new') }}">MATRICULAR ESTUDIANTE</a>
{% endblock %}
